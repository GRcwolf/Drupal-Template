{
    "name": "grcwolf/template",
    "description": "Drupal template",
    "type": "project",
    "homepage": "https://www.drupal.org/project/drupal",
    "license": "proprietary",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^2.0",
        "cweagans/composer-patches": "^2.0",
        "drupal/admin_toolbar": "^3.5",
        "drupal/backup_migrate": "^5.1",
        "drupal/coffee": "^2.0",
        "drupal/config_filter": "^2.7",
        "drupal/config_ignore": "^3.3",
        "drupal/config_split": "^2.0",
        "drupal/core-composer-scaffold": "^11.0",
        "drupal/core-recommended": "^11.0",
        "drupal/linkit": "^7.0",
        "drupal/metatag": "^2.1",
        "drupal/paragraphs": "^1.15",
        "drupal/pathauto": "^1.11",
        "drupal/r4032login": "^2.2",
        "drupal/rabbit_hole": "^1.0",
        "drupal/redirect": "^1.8",
        "drupal/simple_sitemap": "^4.1",
        "drupal/symfony_mailer": "^2.0",
        "drupal/userprotect": "^1.3",
        "drush/drush": "^13.3"
    },
    "require-dev": {
        "drupal/coder": "9.0.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cweagans/composer-patches": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "phpcs -p"
    },
    "extra": {
        "patches": {
            "drupal/core": {
                "29875449 - Database serialization error with ajax": "https://www.drupal.org/files/issues/2025-06-03/29875449.patch"
            }
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        }
    }
}
